import sys, os
sys.path.insert(0, "/tmp/rrdecomp/tools")
import recomp

recomp.load_symbols("/tmp/rrdecomp/asm/29E8.s", "/tmp/rrdecomp/asm/psyq.s")
names = [l.strip() for l in open("/tmp/recomp/listall.txt") if l.strip()]
asm = {}
out = ['#include "rt.h"', '#include "gte.h"',
       "u32 psx_dispatch(u32,u32,u32,u32,u32,u32);"]
txt29 = open("/tmp/rrdecomp/asm/29E8.s", encoding="utf-8", errors="replace").read()
txtpq = open("/tmp/rrdecomp/asm/psyq.s", encoding="utf-8", errors="replace").read()
for nm in names:
    a = c = None
    for p in ("/tmp/rrdecomp/asm/29E8.s", "/tmp/rrdecomp/asm/psyq.s", "/tmp/rrdecomp/asm/header.s"):
        a, c = recomp.func_length(p, nm)
        if a is not None:
            break
    if a is None:
        sys.stderr.write("introuvable : " + nm + "\n")
        continue
    ws = recomp.words_from_exe("/tmp/psx.exe", a, c)
    try:
        out.append(recomp.translate("psx_" + nm, a, ws))
    except recomp.Unsupported as e:
        # Quelques fonctions touchent le coprocesseur systeme (COP0) : elles
        # ne sont pas traduisibles telles quelles. On les remplace par un
        # bouchon qui se signale, plutot que de les taire.
        sys.stderr.write("bouchon %s : %s\n" % (nm, e))
        out.append("u32 psx_%s(u32 a, u32 b, u32 c, u32 d)\n"
                   "{ extern void stub_hit(const char *); "
                   "stub_hit(\"%s\"); return 0; }" % (nm, nm))
open("/tmp/recomp/game_new.c", "w").write("\n".join(out) + "\n")

# Le compteur de rappels CD, insere a la main : il mesure si le jeu recoit
# bien ses propres notifications de lecteur.
s = open("/tmp/recomp/game_new.c").read()
k = "u32 psx_D_8005497C(u32 r_a0, u32 r_a1, u32 r_a2, u32 r_a3)\n{\n"
assert k in s
s = s.replace(k, k + "    { extern unsigned long cdcb_hits; cdcb_hits++; }\n", 1)
open("/tmp/recomp/game_new.c", "w").write(s)
